{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "html-to-ps scene 0.1.0",
    "type": "object",
    "required": [
        "version",
        "canvas",
        "rootSelector",
        "specialization",
        "approvedReferenceImage",
        "specializedReferenceImage",
        "referenceImage",
        "sections",
        "warnings"
    ],
    "properties": {
        "version": {
            "const": "0.1.0"
        },
        "canvas": {
            "type": "object",
            "required": ["width", "height", "resolution"],
            "properties": {
                "width": {
                    "type": "number"
                },
                "height": {
                    "type": "number"
                },
                "resolution": {
                    "const": 72
                }
            }
        },
        "referenceImage": {
            "type": "string"
        },
        "approvedReferenceImage": {
            "type": "string"
        },
        "specializedReferenceImage": {
            "type": "string"
        },
        "specialization": {
            "type": "object",
            "required": ["protocolVersion", "requiredCapabilities", "sourceDigest", "visualValidation"],
            "properties": {
                "protocolVersion": {
                    "const": "0.1"
                },
                "requiredCapabilities": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                },
                "sourceDigest": {
                    "type": "string",
                    "minLength": 1
                },
                "visualValidation": {
                    "type": "object",
                    "required": ["pass", "reportPath"],
                    "properties": {
                        "pass": {
                            "const": true
                        },
                        "reportPath": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            }
        },
        "rootSelector": {
            "type": "string",
            "minLength": 1
        },
        "warnings": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "sections": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/node"
            }
        }
    },
    "$defs": {
        "bounds": {
            "type": "object",
            "required": ["x", "y", "width", "height", "right", "bottom"],
            "properties": {
                "x": {
                    "type": "number"
                },
                "y": {
                    "type": "number"
                },
                "width": {
                    "type": "number"
                },
                "height": {
                    "type": "number"
                },
                "right": {
                    "type": "number"
                },
                "bottom": {
                    "type": "number"
                }
            }
        },
        "color": {
            "type": "object",
            "required": ["r", "g", "b", "a"],
            "properties": {
                "r": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                },
                "g": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                },
                "b": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                },
                "a": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            }
        },
        "renderedFont": {
            "type": "object",
            "required": ["familyName", "postScriptName", "isCustomFont", "glyphCount"],
            "properties": {
                "familyName": {
                    "type": "string"
                },
                "postScriptName": {
                    "type": "string"
                },
                "isCustomFont": {
                    "type": "boolean"
                },
                "glyphCount": {
                    "type": "number",
                    "minimum": 0
                }
            }
        },
        "text": {
            "type": "object",
            "required": [
                "contents",
                "mode",
                "family",
                "postScriptName",
                "sizePx",
                "lineHeightPx",
                "letterSpacingPx",
                "align",
                "color"
            ],
            "properties": {
                "contents": {
                    "type": "string"
                },
                "mode": {
                    "enum": ["point", "paragraph"]
                },
                "family": {
                    "type": "string"
                },
                "postScriptName": {
                    "type": ["string", "null"]
                },
                "sizePx": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "lineHeightPx": {
                    "type": ["number", "null"]
                },
                "letterSpacingPx": {
                    "type": "number"
                },
                "align": {
                    "type": "string"
                },
                "color": {
                    "$ref": "#/$defs/color"
                },
                "renderedFonts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/renderedFont"
                    }
                },
                "renderedPostScriptName": {
                    "type": ["string", "null"]
                }
            }
        },
        "image": {
            "type": "object",
            "required": ["src", "assetPath", "objectFit", "objectPosition"],
            "properties": {
                "src": {
                    "type": "string"
                },
                "assetPath": {
                    "type": ["string", "null"]
                },
                "objectFit": {
                    "type": "string"
                },
                "objectPosition": {
                    "type": "string"
                }
            }
        },
        "shape": {
            "type": "object",
            "required": ["kind", "fill", "borderColor", "borderWidth", "borderRadius"],
            "properties": {
                "kind": {
                    "enum": ["rectangle", "ellipse"]
                },
                "fill": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/color"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "borderColor": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/color"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "borderWidth": {
                    "type": "number",
                    "minimum": 0
                },
                "borderRadius": {
                    "type": "number",
                    "minimum": 0
                }
            }
        },
        "node": {
            "type": "object",
            "required": [
                "id",
                "domId",
                "type",
                "name",
                "locator",
                "mode",
                "bounds",
                "requiredBottom",
                "opacity",
                "fontFamily",
                "rotation",
                "renderWidth",
                "renderHeight",
                "layoutWidth",
                "layoutHeight",
                "scaleX",
                "scaleY",
                "paintOrder",
                "children",
                "text",
                "image",
                "shape",
                "rasterPath",
                "fallbackReason",
                "sourceTrace"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "domId": {
                    "type": ["string", "null"]
                },
                "type": {
                    "enum": ["group", "text", "image", "shape", "raster"]
                },
                "name": {
                    "type": "string"
                },
                "locator": {
                    "type": "string"
                },
                "mode": {
                    "enum": ["native", "smart", "skipped"]
                },
                "bounds": {
                    "$ref": "#/$defs/bounds"
                },
                "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "fontFamily": {
                    "type": "string"
                },
                "rotation": {
                    "type": "number"
                },
                "paintOrder": {
                    "type": "number"
                },
                "children": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/node"
                    }
                },
                "text": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/text"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "image": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/image"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "shape": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/shape"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "rasterPath": {
                    "type": ["string", "null"]
                },
                "fallbackReason": {
                    "type": ["string", "null"]
                },
                "sourceTrace": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/sourceTrace"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "requiredBottom": {
                    "type": "number"
                },
                "renderWidth": {
                    "type": "number"
                },
                "renderHeight": {
                    "type": "number"
                },
                "layoutWidth": {
                    "type": "number",
                    "minimum": 0
                },
                "layoutHeight": {
                    "type": "number",
                    "minimum": 0
                },
                "scaleX": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "scaleY": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "rasterCapture": {
                    "enum": ["element", "backdrop"]
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "text"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "text": {
                                "$ref": "#/$defs/text"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "image"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "image": {
                                "$ref": "#/$defs/image"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "shape"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "shape": {
                                "$ref": "#/$defs/shape"
                            }
                        }
                    }
                }
            ]
        },
        "sourceTrace": {
            "type": "object",
            "required": ["sourceId", "origin", "generated", "originPart", "rewrite"],
            "properties": {
                "sourceId": {
                    "type": ["string", "null"]
                },
                "origin": {
                    "type": ["string", "null"]
                },
                "generated": {
                    "type": "boolean"
                },
                "originPart": {
                    "type": ["string", "null"]
                },
                "rewrite": {
                    "type": ["string", "null"]
                }
            }
        }
    }
}
